# Per-project deploy configuration. Copy this file to `.env` and fill in real values.
# `.env` is gitignored; this template is committed.

# SFTP host (Domeneshop uses login.domeneshop.no for shared webhotels)
DEPLOY_HOST=

# Your SFTP username
DEPLOY_USER=

# Remote path on the server. NO trailing slash. This is the folder that will be
# mirrored to — `--delete` removes anything in it that isn't in your local _site/
# (except the remote-only files in deploy.sh's EXCLUDES list).
# Domeneshop example: /home/N/x/user/yourdomain.tld
# deploy.sh refuses a path whose last folder isn't named after the site.json url
# (yourdomain.tld, or `sub` for sub.yourdomain.tld), and paths with ~, . or ..
DEPLOY_REMOTE=

# Path to the private SSH key. Optional — defaults to ~/.ssh/id_ed25519.
# Use Git Bash forward-slash form (e.g. /e/www/your_key) and avoid spaces.
DEPLOY_KEY=

# --- Optional switches: leave commented out unless needed (docs/deploy.md) ---

# This site's docroot is NOT named after its domain (e.g. a host's `www` or
# `public_html` folder). Run DRY_RUN=1 ./deploy.sh before the first real deploy.
# DEPLOY_ALLOW_PATH_MISMATCH=1

# Pin the server's host key: connect only if it is already in known_hosts
# (from the one-time `ssh DEPLOY_USER@DEPLOY_HOST` test in docs/deploy.md).
# Default: trust a new server on first contact, refuse one whose key changed.
# DEPLOY_STRICT_HOSTKEY=1
