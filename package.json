{
  "name": "eleventy-bootstrap-boilerplate",
  "version": "1.0.0",
  "description": "Eleventy 3.0 + Bootstrap 5.3 boilerplate with theme switching, SEO, accessibility, and Apache hosting",
  "scripts": {
    "start": "eleventy --serve",
    "build": "npm run lint:css && eleventy && html-validate \"_site/**/*.html\" && node scripts/minify.js",
    "validate": "html-validate \"_site/**/*.html\"",
    "lint:css": "stylelint \"src/assets/css/*.css\"",
    "deploy": "npm run build && ./deploy.sh _site",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "clean-css": "^5.3.3",
    "html-validate": "^10.15.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "terser": "^5.46.1"
  }
}
