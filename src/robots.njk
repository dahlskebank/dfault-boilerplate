---
# ============================================================
#  ROBOTS.TXT  —  src/robots.njk
# ============================================================
#
#  Generates /robots.txt for search engine and AI crawlers.
#  Excluded from collections so it won't appear in sitemaps
#  or navigation loops.
#
#  Don't edit the output by hand — change the switches in
#  src/_data/site.json (aiPolicy, noindexSite) and the bot
#  names in src/_data/aiBots.js.
# ============================================================
permalink: /robots.txt
eleventyExcludeFromCollections: true
layout: false
---
{#- ------------------------------------------------------------
	HOW ROBOTS.TXT GROUPS WORK (why this template looks like this)
	- A crawler obeys exactly ONE group: the most specific
	  User-agent match. A bot with its own group IGNORES the
	  `User-agent: *` group completely (groups are never merged).
	- So we only print named groups for bots we BLOCK. Allowed
	  bots fall through to `User-agent: *`.
	- Several User-agent lines may share one rule block.
	- A switch counts as "allowed" unless it is exactly false
	  (`!== false`), so an older site.json without aiPolicy
	  still allows everything.

	PLAIN TEXT, NOT HTML: Eleventy's Nunjucks auto-escapes output
	for HTML, which would turn "Dahl's" into "Dahl&#39;s" here.
	`| safe` switches that off for the interpolated values.
------------------------------------------------------------ -#}
{%- set p = site.aiPolicy or {} -%}
{%- set allowed = {
	train: p.train !== false,
	search: p.search !== false,
	userFetch: p.userFetch !== false
} -%}
# robots.txt for {{ site.name | safe }} ({{ site.url | safe }})
# Generated by Eleventy from src/robots.njk. Edit src/_data/site.json -> aiPolicy.
{% if site.noindexSite %}
# Private / staging site (site.noindexSite = true).
# Crawling stays ALLOWED on purpose: pages are kept out of search
# and AI indexes by the noindex <meta> tag and X-Robots-Tag header,
# and a crawler blocked here would never get to see those.
User-agent: *
Allow: /
{%- else %}
# AI crawlers: training={{ "allowed" if allowed.train else "blocked" }}, AI search={{ "allowed" if allowed.search else "blocked" }}, user-triggered fetches={{ "allowed" if allowed.userFetch else "blocked" }}
{% for key in ["train", "search", "userFetch"] %}
{%- if not allowed[key] %}
# --- Blocked: {{ aiBots[key].label | safe }} ---
{%- for bot in aiBots[key].bots %}
User-agent: {{ bot.token | safe }}
{%- endfor %}
Disallow: /
{% endif %}
{%- endfor %}
User-agent: *
{%- if p.contentSignal %}
{#- Cloudflare's Content Signals (contentsignals.org): search = classic
	search results, ai-input = feeding AI answers/grounding (follows
	aiPolicy.search), ai-train = model training. A preference only. #}
Content-Signal: search=yes, ai-input={{ "yes" if allowed.search else "no" }}, ai-train={{ "yes" if allowed.train else "no" }}
{%- endif %}
Allow: /

Sitemap: {{ site.url | safe }}/sitemap.xml
{%- endif %}
