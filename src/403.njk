---
# ============================================================
#  403 PAGE  —  src/403.njk
# ============================================================
#
#  Same permalink trick as 404.njk — we need this at the site
#  root as 403.html for the .htaccess ErrorDocument directive.
#  Same noindex reason too (a direct request answers 200), and
#  the same `cover: true` (centred between navbar and footer).
# ============================================================
layout: base.njk
title: 403 Access Forbidden
mainClass: px-3 text-center
cover: true
permalink: /403.html
eleventyExcludeFromCollections: true
robots: "noindex, follow"
---

<div class="dd-embossed">
	{# Heading + muted-text pattern explained in 404.njk #}
	<h1 class="mb-4">
		<span class="d-block display-1 text-danger">403</span>
		<span class="d-block display-3">Access Forbidden</span>
	</h1>
	<p class="lead text-body-secondary mb-5">
		You don’t have permission to access this page.
		Either you took a wrong turn, or you’re attempting something wildly suspicious.

		In either case, this area is off-limits.
	</p>
	<a href="/" class="btn btn-primary">Back to civilization</a>
</div>
