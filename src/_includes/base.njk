{# ============================================================
		BASE LAYOUT  —  src/_includes/base.njk
	 ============================================================

	 This is the master layout that wraps every page on the site.
	 Think of it as the skeleton HTML that every page shares.

	 HOW LAYOUTS WORK IN ELEVENTY:
	 ----------------------------
	 Each page file (like index.njk) specifies `layout: base.njk`
	 in its front matter.  Eleventy then:
		 1. Renders the page content
		 2. Injects it into {{ content | safe }} below
		 3. Outputs the complete HTML file

	 The `| safe` filter tells Nunjucks "this content is already
	 HTML, don't escape the < and > characters."

	 FRONT MATTER VARIABLES:
	 ----------------------
	 Pages can set these in their front matter (the --- block):
		 title          → Used in <title> and meta tags (falls back to site.name)
		 description    → Meta description (falls back to site.description)
		 bodyClass      → CSS classes on <body> (default: "d-flex h-100 cover-container")
		 mainClass      → CSS classes on <main> (default: "px-3")
		 containerClass → Bootstrap container variant wrapping <main> + footer
		                  (default: "container"). Use "container-fluid" for a
		                  full-width page (e.g. wide data tables), or one of the
		                  responsive variants like "container-xxl".

	 PER-PAGE EXTRAS (head + scripts):
	 ---------------------------------
	 Pages inject extra <head> stylesheets and end-of-body scripts via
	 frontmatter arrays — NOT via Nunjucks `{% block %}`.

	 Why: with `layout: base.njk` frontmatter, Eleventy renders the page
	 standalone before injecting it into `{{ content | safe }}`, so child
	 `{% block %}` overrides never reach this parent. Frontmatter-driven
	 arrays are Eleventy's recommended per-page-extras mechanism.

	 Example frontmatter:
		 extraCss: ["/assets/css/expiry.css"]
		 extraScripts:
		   - { src: "https://cdn.sheetjs.com/.../xlsx.full.min.js", cdn: true }
		   - "/assets/js/expiry.js"

	 See the inline comments at the loop sites below for full schema.
	 ============================================================ #}

<!DOCTYPE html>
<html lang="{{ site.lang }}" class="h-100">
<head>
	{# --- Theme init (must run before any CSS to prevent FOUC) --- #}
	{% include "theme-init.njk" %}

	{# --- SEO meta tags (title, description, Open Graph, Twitter Card) --- #}
	{% include "head-meta.njk" %}

	{# --- CSS, fonts, favicons, analytics --- #}
	{% include "head-assets.njk" %}

	{# --- Page-specific stylesheets ---
		 Pages opt in via the `extraCss:` frontmatter array. Each entry is
		 an href string. Local paths get the build's cache-bust query
		 appended automatically; anything starting with `http` is passed
		 through untouched so external CDN stylesheets keep their own
		 versioning intact.

		 Why frontmatter and not `{% block head %}`? Eleventy's `layout:`
		 frontmatter renders the page standalone first, then injects the
		 rendered HTML into `{{ content | safe }}` here — so child-template
		 `{% block %}` overrides don't reach the parent. Frontmatter is the
		 official Eleventy-way of passing per-page extras to a layout. #}
	{% if extraCss %}{% for href in extraCss %}<link rel="stylesheet" href="{{ href }}{% if href.indexOf("http") != 0 %}?v={{ cacheBust }}{% endif %}">
	{% endfor %}{% endif %}
</head>

<body class="{{ bodyClass | default('d-flex h-100 cover-container') }}">

	{# --- Skip-to-content (accessibility — visible on focus) --- #}
	<a class="visually-hidden-focusable position-absolute top-0 start-0 m-2 btn btn-primary btn-sm" href="#content">Skip to main content</a>

	{# --- Fixed-top navbar --- #}
	{% include "navbar.njk" %}

	{# --- Offcanvas navigation menu --- #}
	{% include "offcanvas-menu.njk" %}

	{# --- Page content wrapper --- #}
	<div id="dd-page" class="w-100 d-flex flex-column">
		<div class="{{ containerClass | default('container') }} d-flex w-100 h-100 p-3 mx-auto flex-column">

			{# --- Flex spacer — mb-auto pushes main+footer down,
				 preserving the cover-page vertical centering. --- #}
			<div class="mb-auto"></div>

			<main id="content" class="{{ mainClass | default('px-3') }}">
				{# --- Page content gets injected here --- #}
				{{ content | safe }}
			</main>

			{% include "footer.njk" %}

		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
					integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
					crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/umd/photoswipe.umd.min.js"
					integrity="sha384-k8EKyYcONphQ7zH4cQ0888JapXwrLTXQl/Ue1/jYgjVYahln1NWpnt2S4IC56LNh"
					crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/umd/photoswipe-lightbox.umd.min.js"
					integrity="sha384-IiBVbUz6+U+Tbm/ijO2P0XRwcVzNfrMzloNLkrqHkbi6w5H0v6ie4fI9BIO4SwdK"
					crossorigin="anonymous"></script>
	{# --- Site-wide JS bundle ---
		 One request instead of six. The bundle is concatenated at build
		 time by the "JS BUNDLING" section in eleventy.config.js from the
		 separate source files in src/assets/js/ (dfault, theme-toggle,
		 flat-toggle, bootswatch-switcher*, offcanvas-init, dd-copy).
		 *bootswatch-switcher is only included when site.bootswatchSwitcher
		 is true. Edit the source files as usual — every build (and every
		 --watch rebuild) regenerates the bundle. #}
	<script src="/assets/js/bundle.js?v={{ cacheBust }}"></script>

	{# --- Page-specific scripts ---
		 Pages opt in via the `extraScripts:` frontmatter array. Each entry
		 is either a string (interpreted as a local non-module script — gets
		 cache-bust appended) or an object with shape:
			 { src, type?, cdn?, integrity?, crossorigin? }
		 - `type: "module"` emits a module script (for ES-module entry points).
		 - `cdn: true` skips the cache-bust suffix (use for third-party CDN URLs).
		 - `integrity` + `crossorigin` pass through to the <script> tag (SRI).
		 See the `extraCss` comment in <head> for why this is frontmatter-driven
		 rather than `{% block scripts %}`. #}
	{% if extraScripts %}{% for s in extraScripts %}{% if s is string %}<script src="{{ s }}?v={{ cacheBust }}"></script>
	{% else %}<script {% if s.type %}type="{{ s.type }}" {% endif %}src="{{ s.src }}{% if not s.cdn %}?v={{ cacheBust }}{% endif %}"{% if s.integrity %} integrity="{{ s.integrity }}"{% endif %}{% if s.crossorigin %} crossorigin="{{ s.crossorigin }}"{% endif %}></script>
	{% endif %}{% endfor %}{% endif %}

	{# --- Cookie consent toast — informational, non-blocking --- #}
	<div class="position-fixed bottom-0 start-50 translate-middle-x mb-3" style="z-index:1055">
		<div id="dd-cookie-toast" class="toast align-items-center text-center shadow-sm" role="alert" aria-live="polite" aria-atomic="true" data-bs-autohide="false">
			<div class="d-flex">
				<div class="toast-body small">
					<i class="bi bi-cookie me-1"></i>
					We use cookies to improve our experience. By continuing, you accept.
					<a href="/legal/#cookie-policy">Would you like to know more?</a>
				</div>
				<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
			</div>
		</div>
	</div>

	{# --- HC SVG duotone filter (referenced by high-contrast.css for .high-contrast-custom) --- #}
	{% include "hc-svg-filters.njk" %}

</body>
</html>
