{#
	 ============================================================
		THEME TOGGLE (OFFCANVAS)  —  src/_includes/theme-toggle-offcanvas.njk
	 ============================================================

	 Dark/Light/Auto/High-contrast theme buttons for the offcanvas
	 menu. Uses the same themes.js data and dd-theme-option class
	 as the navbar version (theme-toggle.njk).

	 - role="group" + aria-labelledby: screen readers announce the
	   buttons as one "Theme" group instead of a loose run of
	   buttons in the menu.
	 - aria-pressed: theme-toggle.js marks the selected theme.
	 - .dd-btn-ghost (style.css §4.4) instead of
	   btn-outline-secondary, whose #6c757d text was only 3.29:1
	   in dark mode at this size.
	 - Standard-group buttons are half width (.dd-theme-half), so
	   Dark | Light share a row and Auto takes the next one.

	 Included by offcanvas-menu.njk.
	 ============================================================
#}

<div class="dd-offcanvas-divider"></div>
<div class="dd-offcanvas-section" id="dd-theme-heading">
	<i class="bi bi-circle-half me-1" aria-hidden="true"></i> Theme
</div>
<div class="d-flex flex-wrap gap-1 px-3 pb-3" role="group" aria-labelledby="dd-theme-heading">
	{% for theme in themes %}
		<button type="button" class="btn btn-sm dd-btn-ghost dd-theme-option{% if theme.group == 'standard' %} dd-theme-half{% else %} flex-fill w-100{% endif %}"
			data-theme="{{ theme.id }}" aria-pressed="false">
			<i class="bi {{ theme.icon | replace('bi ', '') }} me-1" aria-hidden="true"></i> {{ theme.label }}
		</button>
	{% endfor %}
</div>
