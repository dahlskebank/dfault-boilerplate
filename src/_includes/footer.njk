<footer class="mt-auto py-4 py-lg-5 border-top text-center small">
	<p class="pb-1">
		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="/legal/#privacy-policy">Privacy Policy</a>
			<i class="bi bi-dot"></i>
			<a class="text-start text-nowrap" href="/legal/#cookie-policy">Cookie Policy</a>
		</span>
		<i class="bi bi-dot d-none d-sm-inline"></i>
		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="/legal/#terms-of-service">Terms of Service</a>
			<i class="bi bi-dot"></i>
			<a class="text-start text-nowrap" href="/legal/">Legal Notice</a>
		</span>
	</p>

	<p class="mb-0">
		{# --- Copyright line --- #}
		<span class="d-none d-lg-inline">Copyright</span>
		<i class="bi bi-c-circle"></i>
		{{ site.footer.startYear }} <i class="bi bi-activity"></i> {% year %}
		<i class="bi bi-arrow-right-short"></i>
		<a class="text-nowrap" href="{{ site.footer.copyrightUrl }}" title="{{ site.footer.copyrightName }} | {{ site.description }}">{{ site.footer.copyrightName }}</a><span class="d-none d-lg-inline">. All rights reserved.</span>
		<small>{{ site.version }}</small>
		<br />

		{# --- Brand links — paired rows on mobile, single inline line on desktop ---
		   Same dd-footer-row pattern as the legal row above (see style.css §2.3).
		   On mobile each <span> becomes a 1fr / auto / 1fr grid with the bi-slash
		   pinned to horizontal center; on ≥ sm the spans collapse to inline so the
		   four links read as one line. The bi-slash between the two spans is
		   d-none d-sm-inline so it only joins the line on desktop.

		   Pairing is hard-coded (links[0]+[1] for row 1, links[2]+[3] for row 2)
		   because site.footer.links has a stable count of 4. If you change that
		   count, add or remove pair-rows manually here. #}

		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="{{ site.footer.links[0].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[0].title }}">{{ site.footer.links[0].label }}</a>
			<i class="bi bi-slash"></i>
			<a class="text-start text-nowrap" href="{{ site.footer.links[1].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[1].title }}">{{ site.footer.links[1].label }}</a>
		</span>
		<i class="bi bi-slash d-none d-sm-inline"></i>
		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="{{ site.footer.links[2].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[2].title }}">{{ site.footer.links[2].label }}</a>
			<i class="bi bi-slash"></i>
			<a class="text-start text-nowrap" href="{{ site.footer.links[3].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[3].title }}">{{ site.footer.links[3].label }}</a>
		</span>
	</p>
</footer>
