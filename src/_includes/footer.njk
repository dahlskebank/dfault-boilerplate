<footer class="mt-auto py-4 py-lg-5 border-top text-center small" role="contentinfo">
	<p class="pb-1">
		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="/legal/#privacy-policy">Privacy Policy</a>
			<i class="bi bi-dot"></i>
			<a class="text-start text-nowrap" href="/legal/#cookie-policy">Cookie Policy</a>
		</span>
		<i class="bi bi-dot d-none d-sm-inline"></i>
		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="/legal/#terms-of-service">Terms of Service</a>
			<i class="bi bi-dot"></i>
			<a class="text-start text-nowrap" href="/legal/">Legal Notice</a>
		</span>
	</p>

	<p class="mb-0">
		{# --- Copyright line --- #}
		<span class="d-none d-lg-inline">Copyright</span>
		<i class="bi bi-c-circle"></i>
		{{ site.footer.startYear }} <i class="bi bi-activity"></i> {% year %}
		<i class="bi bi-dot"></i>
		<a href="{{ site.footer.copyrightUrl }}" title="{{ site.footer.copyrightName }} | {{ site.description }}">{{ site.footer.copyrightName }}</a>
		<i class="bi bi-dot"></i>
		{{ site.version }}
		<br />

		{# --- Brand links — paired rows on mobile, single inline line on desktop ---
		   Same dd-footer-row pattern as the legal row above (see style.css §2.3).
		   On mobile each <span> becomes a 1fr / auto / 1fr grid with the bi-slash
		   pinned to horizontal center; on ≥ sm the spans collapse to inline so the
		   four links read as one line. The bi-slash between the two spans is
		   d-none d-sm-inline so it only joins the line on desktop.

		   Pairing is hard-coded (pendingLabel + links[0], links[1] + links[2])
		   because site.footer.links has a stable count of 3 across Daniel's sites.
		   Add a third pair-row manually if you ever extend site.footer.links. #}

		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			{# "Back to hub" — when pendingUrl is THIS site, render without target=_blank so it's an in-site link (the hub linking to itself). #}
			{% if site.footer.pendingUrl == site.url %}
			<a class="text-end text-nowrap" href="{{ site.footer.pendingUrl }}" title="{{ site.footer.pendingLabel }}">{{ site.footer.pendingLabel }}</a>
			{% else %}
			<a class="text-end text-nowrap" href="{{ site.footer.pendingUrl }}" target="_blank" rel="noopener" title="{{ site.footer.pendingLabel }}">{{ site.footer.pendingLabel }}</a>
			{% endif %}
			<i class="bi bi-slash"></i>
			<a class="text-start text-nowrap" href="{{ site.footer.links[0].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[0].title }}">{{ site.footer.links[0].label }}</a>
		</span>
		<i class="bi bi-slash d-none d-sm-inline"></i>
		<span class="d-grid d-sm-inline align-items-center gap-2 dd-footer-row">
			<a class="text-end text-nowrap" href="{{ site.footer.links[1].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[1].title }}">{{ site.footer.links[1].label }}</a>
			<i class="bi bi-slash"></i>
			<a class="text-start text-nowrap" href="{{ site.footer.links[2].url }}" target="_blank" rel="noopener" title="{{ site.footer.links[2].title }}">{{ site.footer.links[2].label }}</a>
		</span>
	</p>
</footer>
