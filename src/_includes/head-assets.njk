{# ============================================================
	HEAD-ASSETS PARTIAL	—	src/_includes/head-assets.njk
	============================================================

	This partial loads all CSS, fonts, icons, favicons, and analytics.

	ORDER MATTERS:
	1. Canonical link (SEO — tells search engines the "real" URL)
	2. Favicons (browser tab/bookmark icons)
	3. Preconnects (speed up third-party resource loading)
	4. Third-party CSS (Bootstrap/Bootswatch, icons)
	5. Local CSS (your custom styles — loaded LAST to override)
	6. Analytics (async, won't block rendering)

	BOILERPLATE NOTE:
	-----------------
	- Swap the Bootswatch link for plain Bootstrap if you don't
	need the theme switcher.
	- Set googleFontsUrl in site.json to load custom fonts.
	- Update the GA measurement ID in site.json.
	============================================================ #}

{# --- Canonical URL (prevents duplicate content in search engines) --- #}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">

{# --- Favicons ---
	Replace these placeholder files with your own.
	Generate a full set at https://realfavicongenerator.net #}
<link rel="icon" type="image/png" href="/assets/img/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="{{ site.webmanifest.shortName }}" />
<link rel="manifest" href="/site.webmanifest" />

{# --- Preconnects ---
	These tell the browser to start connecting to CDN servers early,
	before it even discovers the CSS/JS links below.
	This saves ~100-200ms per resource on first load. #}
<link rel="preconnect" href="https://cdnjs.cloudflare.com">
<link rel="preconnect" href="https://cdn.jsdelivr.net">
{% if site.googleFontsUrl %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% endif %}

{# --- Bootswatch Theme CSS ---
	This loads a Bootswatch theme (Bootstrap with custom styling).
	The id="bootswatch-theme" is used by the JS theme switcher
	to swap this stylesheet dynamically.

	If you don't need the theme switcher, replace this with plain Bootstrap:
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
			integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
			crossorigin="anonymous">
#}
{% if site.defaultBootswatchTheme == "default" %}
<link id="bootstrap-default"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
		integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
		crossorigin="anonymous">
{% else %}
<link id="bootswatch-theme"
		rel="stylesheet"
		href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.8/{{ site.defaultBootswatchTheme }}/bootstrap.min.css"
		crossorigin="anonymous"
		referrerpolicy="no-referrer">
{% endif %}

{# --- Bootstrap Icons --- #}
<link rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
		integrity="sha384-CK2SzKma4jA5H/MXDUU7i1TqZlCFaD4T01vtyDFvPlD97JQyS+IsSh1nI2EFbpyk"
		crossorigin="anonymous">

{# --- Google Fonts (configurable via site.json) ---
	Set site.googleFontsUrl in site.json to load custom fonts.
	Example: "https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap"
	Leave as empty string "" to use system fonts. #}
{% if site.googleFontsUrl %}
<link rel="stylesheet" href="{{ site.googleFontsUrl }}">
{% endif %}

{# --- PhotoSwipe lightbox CSS --- #}
<link rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.min.css"
		integrity="sha384-CKeYI6jsYBV4DV34zRfxht32qlPolZvokUknVb7SnE4PCoiTTqCN47Tr+hQAKkXY"
		crossorigin="anonymous">

{# --- Your custom stylesheet (loaded LAST so it can override everything above) --- #}
<link rel="stylesheet" href="/assets/css/style.css?v={{ cacheBust }}" id="site-css" media="all">

{# --- Google Analytics ---
	Only loads if site.gaId is set in site.json.
	The "async" attribute means it won't block page rendering.

	To disable analytics: set gaId to "" in site.json.
#}
{% if site.gaId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId }}"></script>
<script>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());
	gtag('config', '{{ site.gaId }}');
</script>
{% endif %}
