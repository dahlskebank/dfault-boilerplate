{# ============================================================
	HEAD-ASSETS PARTIAL	—	src/_includes/head-assets.njk
	============================================================

	This partial loads all CSS, fonts, icons, favicons, and analytics.

	ORDER MATTERS:
	1. Canonical link (SEO — tells search engines the "real" URL)
	2. Favicons (browser tab/bookmark icons)
	3. Preconnects (speed up third-party resource loading)
	4. Third-party CSS (Bootstrap/Bootswatch, icons)
	5. Local CSS (your custom styles — loaded LAST to override)
	6. Analytics (async, won't block rendering)

	BOILERPLATE NOTE:
	-----------------
	- Pick a Bootswatch theme (or "default" for plain Bootstrap)
	with site.json → defaultBootswatchTheme.
	- CDN versions, URLs and SRI hashes all live in
	src/_data/cdn.js ({{ cdn.xxx }} below) — bump them there.
	- Set googleFontsUrl in site.json to load custom fonts.
	- Update the GA measurement ID in site.json.
	============================================================ #}

{# --- Canonical URL (prevents duplicate content in search engines) ---
	The rel="sitemap" link is harmless but optional: Google finds the
	sitemap through robots.txt's "Sitemap:" line or Search Console. #}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">

{# --- Favicons (RealFaviconGenerator file names) ---
	The boilerplate ships the dfault floppy-disk set as a WORKING
	placeholder, so nothing 404s. For a real site, generate a new set
	at https://realfavicongenerator.net and overwrite these files
	(keep the names):
		src/favicon.ico                        → /favicon.ico (48/32/16 px in one file)
		src/assets/img/favicon-96x96.png       PNG tab icon; what Google Search uses
		src/assets/img/favicon.svg             crisp in modern browsers' tabs — but
		                                       Google Search's favicon docs don't list
		                                       SVG, hence the PNG/ICO alongside it
		src/assets/img/apple-touch-icon.png    180x180 home-screen icon
		src/assets/img/web-app-manifest-*.png  192/512 + 512 maskable (site.webmanifest) #}
<link rel="icon" type="image/png" href="/assets/img/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="{{ site.webmanifest.shortName or site.name }}" />
<link rel="manifest" href="/site.webmanifest" />

{# --- Preconnects ---
	These tell the browser to start connecting to CDN servers early,
	before it even discovers the CSS/JS links below.
	This saves ~100-200ms per resource on first load.

	`crossorigin` matters: every CDN file below is loaded with
	crossorigin="anonymous" (required for SRI), and browsers keep
	CORS and non-CORS connections in separate pools — a preconnect
	without it warms a connection those files can't use.
	cdnjs is only preconnected when a Bootswatch theme loads from it.

	`bootswatch` = this theme's { url, integrity } from src/_data/cdn.js,
	or null for "default" (plain Bootstrap) or a name cdn.js doesn't know. #}
{%- set bootswatch = cdn.bootswatch.themes[site.defaultBootswatchTheme] if site.defaultBootswatchTheme != "default" else null %}
{% if bootswatch %}
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
{% endif %}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
{% if site.googleFontsUrl %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{% endif %}

{# --- Bootstrap / Bootswatch Theme CSS ---
	Plain Bootstrap (site.defaultBootswatchTheme = "default") or a
	Bootswatch theme (Bootstrap with custom styling). The ids
	"bootstrap-default" / "bootswatch-theme" are used by the JS theme
	switcher to swap this stylesheet dynamically.

	Both come with SRI (`integrity`) from src/_data/cdn.js. A theme name
	that isn't listed there falls back to plain Bootstrap, with an HTML
	comment saying so (view source) — check the spelling in site.json.
	(`bootswatch` was looked up in the Preconnects section above.) #}
{% if bootswatch %}
<link id="bootswatch-theme"
		rel="stylesheet"
		href="{{ bootswatch.url }}"
		integrity="{{ bootswatch.integrity }}"
		crossorigin="anonymous"
		referrerpolicy="no-referrer">
{% else %}
{% if site.defaultBootswatchTheme and site.defaultBootswatchTheme != "default" %}<!-- site.json defaultBootswatchTheme "{{ site.defaultBootswatchTheme }}" is not in src/_data/cdn.js: loading plain Bootstrap -->
{% endif %}
<link id="bootstrap-default"
		rel="stylesheet"
		href="{{ cdn.bootstrap.css.url }}"
		integrity="{{ cdn.bootstrap.css.integrity }}"
		crossorigin="anonymous">
{% endif %}

{# --- Bootstrap Icons --- #}
<link rel="stylesheet"
		href="{{ cdn.bootstrapIcons.css.url }}"
		integrity="{{ cdn.bootstrapIcons.css.integrity }}"
		crossorigin="anonymous">

{# --- Google Fonts (configurable via site.json) ---
	Set site.googleFontsUrl in site.json to load custom fonts.
	Example: "https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap"
	Leave as empty string "" to use system fonts. #}
{% if site.googleFontsUrl %}
<link rel="stylesheet" href="{{ site.googleFontsUrl }}">
{% endif %}

{# --- PhotoSwipe lightbox CSS ---
	Only on pages that use the lightbox, same rule as its two scripts
	at the end of <body>: `loadPhotoswipe` is set in base.njk just
	before this partial is included (a variable `set` in the layout is
	visible inside its includes). Every other page skips one
	render-blocking CDN stylesheet. #}
{% if loadPhotoswipe %}
<link rel="stylesheet"
		href="{{ cdn.photoswipe.css.url }}"
		integrity="{{ cdn.photoswipe.css.integrity }}"
		crossorigin="anonymous">
{% endif %}

{# --- Your custom stylesheet (loaded LAST so it can override everything above) --- #}
<link rel="stylesheet" href="/assets/css/style.css?v={{ cacheBust }}" id="site-css" media="all">

{# --- Flat utility (orthogonal binary toggle, .flat on <html>) ---
	Loaded after style.css so it wins on border-radius / shadows.
	Bootswatch switcher inserts new themes BEFORE #site-css, so
	this file (and the HC file below) always stay last.
	Skipped when site.json → flatToggle is false: theme-init.njk then
	never adds .flat, so nothing in the file could match. #}
{% if site.flatToggle !== false %}
<link rel="stylesheet" href="/assets/css/flat.css?v={{ cacheBust }}" id="flat-css" media="all">
{% endif %}

{# --- High contrast (after Bootstrap, style.css and flat.css) ---
	Class on <html>: high-contrast-dark / -light / -custom. The
	custom-mode SVG duotone filter is injected once near </body>
	via hc-svg-filters.njk.
	It is the last stylesheet in THIS partial, but not on the page:
	a page's own `extraCss` links (base.njk) come after it. So page
	CSS must respect HC: use Bootstrap tokens (var(--bs-*)), which
	the HC token map recolours. #}
<link rel="stylesheet" href="/assets/css/high-contrast.css?v={{ cacheBust }}" id="hc-css" media="all">

{# --- Google Analytics ---
	Only loads if site.gaId is set in site.json.
	The "async" attribute means it won't block page rendering.

	To disable analytics: set gaId to "" in site.json.

	The ID is written with `| urlencode` inside the URL and with
	`| dump | safe` inside the script (a proper JS string, quotes
	included) — HTML escaping is the wrong kind of escaping in both.

	CONSENT (site.json → gaConsent):
	- "implied" (default): GA loads right away, as below; the cookie
	  toast only informs.
	- "required": nothing is loaded and nothing is sent to Google
	  until the visitor clicks Accept in the cookie toast. This block
	  then only DEFINES window.ddLoadAnalytics() (dfault.js calls it
	  on Accept) and runs it straight away on later pages once
	  "analyticsConsent" = "granted" is saved. Same gtag.js tag,
	  just added by script instead of by the parser. (This is
	  "basic" consent mode: Google's "advanced" mode loads gtag.js
	  anyway and sends cookieless pings before consent.)
	  window.ddStopAnalytics() is for Decline after an earlier
	  Accept: the official ga-disable-<ID> switch, plus deleting
	  the _ga cookies GA set on this domain.
	  In this branch the URL is built in JS, so encodeURIComponent
	  does the job `| urlencode` does above (they're the same
	  function); the ID itself still goes in with `| dump | safe`.
	  ddStore comes from theme-init.njk, which runs earlier in <head>.
#}
{% if site.gaId and site.gaConsent == "required" %}
<script>
(function () {
	var GA_ID = {{ site.gaId | dump | safe }};
	var loaded = false;

	window.ddLoadAnalytics = function () {
		window["ga-disable-" + GA_ID] = false;
		if (loaded) return;
		loaded = true;
		var s = document.createElement("script");
		s.async = true;
		s.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(GA_ID);
		document.head.appendChild(s);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { window.dataLayer.push(arguments); };
		window.gtag("js", new Date());
		window.gtag("config", GA_ID);
	};

	window.ddStopAnalytics = function () {
		window["ga-disable-" + GA_ID] = true;
		{# GA writes its cookies on the widest domain it can (".example.com"),
		   so try every parent domain; the browser ignores the ones that
		   don't apply. #}
		var parts = location.hostname.split(".");
		document.cookie.split(";").forEach(function (c) {
			var name = c.split("=")[0].trim();
			if (!/^_ga/.test(name)) return;
			for (var i = 0; i < parts.length; i++) {
				var domain = parts.slice(i).join(".");
				document.cookie = name + "=; Max-Age=0; path=/; domain=" + domain;
			}
			document.cookie = name + "=; Max-Age=0; path=/";
		});
	};

	if (window.ddStore && ddStore.get("analyticsConsent") === "granted") window.ddLoadAnalytics();
})();
</script>
{% elif site.gaId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gaId | urlencode }}"></script>
<script>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());
	gtag('config', {{ site.gaId | dump | safe }});
</script>
{% endif %}
