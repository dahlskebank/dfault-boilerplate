{#
	 ============================================================
		OFFCANVAS MENU  —  src/_includes/offcanvas-menu.njk
	 ============================================================

	 Navigation panel using Bootstrap Offcanvas — available on
	 both mobile and desktop.  Reads the same nav.js data as
	 the navbar.

	 For dropdown parents (items with children):
	   - A section header shows the parent label
	   - The parent itself becomes the first link ("All [label]")
	   - Children are listed below with slight indentation

	 Active state uses page.url, same logic as navbar.
	 ============================================================
#}

<div id="dd-offcanvas" class="offcanvas offcanvas-start dd-offcanvas-menu"
	tabindex="-1" aria-labelledby="dd-offcanvas-label">

	<div class="offcanvas-header">
		<h5 class="offcanvas-title" id="dd-offcanvas-label">{{ site.name }}</h5>
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>

	<div class="offcanvas-body dd-offcanvas-nav">

		{# --- Home link (always first) --- #}
		<a class="nav-link{% if page.url == '/' %} active{% endif %}" href="/"
			{% if page.url == '/' %}aria-current="page"{% endif %}>
			<i class="bi bi-house-door me-1"></i> Home
		</a>

		<div class="dd-offcanvas-divider"></div>

		{% for item in nav %}
			{% if item.children %}
				{# --- Section with children --- #}
				<div class="dd-offcanvas-section">
					<i class="{{ item.icon }} me-1"></i> {{ item.label }}
				</div>

				{# Parent as a clickable link (only shown if item has a url) #}
				{% if item.url %}
					<a class="nav-link dd-offcanvas-child{% if item.disabled %} disabled{% endif %}{% if page.url == item.url %} active{% endif %}"
						href="{{ item.url }}"
						{% if page.url == item.url %}aria-current="page"{% endif %}>
						<i class="{{ item.icon }} me-1"></i> All {{ item.label }}
					</a>
				{% endif %}

				{# Children #}
				{% for child in item.children %}
					<a class="nav-link dd-offcanvas-child{% if child.disabled %} disabled{% endif %}{% if page.url == child.url %} active{% endif %}"
						href="{{ child.url }}"
						{% if child.external %}target="_blank" rel="noopener"{% endif %}
						{% if page.url == child.url %}aria-current="page"{% endif %}>
						{% if child.icon %}<i class="{{ child.icon }} me-1"></i>{% endif %}
						{{ child.label }}
					</a>
				{% endfor %}

				<div class="dd-offcanvas-divider"></div>
			{% else %}
				{# --- Plain link --- #}
				<a class="nav-link{% if item.disabled %} disabled{% endif %}{% if page.url == item.url %} active{% endif %}"
					href="{{ item.url }}"
					{% if page.url == item.url %}aria-current="page"{% endif %}
					{% if item.external %}target="_blank" rel="noopener"{% endif %}>
					{% if item.icon %}<i class="{{ item.icon }} me-1"></i>{% endif %}
					{{ item.label }}
					{% if item.external %}<i class="bi bi-box-arrow-up-right ms-auto small"></i>{% endif %}
				</a>
			{% endif %}
		{% endfor %}

		{# --- Dark/Light/Contrast toggle (from themes.js) --- #}
		{% include "theme-toggle-offcanvas.njk" %}

		{# --- Bootswatch CSS framework switcher (dev tool, toggle in site.json) --- #}
		{% if site.bootswatchSwitcher %}
			{% include "bootswatch-switcher.njk" %}
		{% endif %}

	</div>
</div>
