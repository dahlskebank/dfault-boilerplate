	{# --- Third-party services ---
	   Every line here is driven by site.json, so it stays accurate:
	   jsDelivr is always used (Bootstrap, Bootstrap Icons; PhotoSwipe
	   only on pages with an image gallery, see `loadPhotoswipe` in
	   base.njk); cdnjs only for a Bootswatch theme or the theme switcher;
	   Google Analytics only with gaId.
	   Google Fonts: with googleFontsUrl, AND whenever a Bootswatch theme
	   that @imports Google Fonts in its own CSS can load — the site's
	   default theme, or any theme a visitor picks in the switcher. Most
	   themes do; the few that don't are listed in src/_data/cdn.js
	   (bootswatch.noGoogleFonts). The `in` operator tests a key of an
	   object (cdn.bootswatch.themes) or an item of a list. #}
	{% set bsTheme = site.defaultBootswatchTheme or "default" %}
	{% set themeFonts = bsTheme != "default" and (bsTheme in cdn.bootswatch.themes) and not (bsTheme in cdn.bootswatch.noGoogleFonts) %}
	<section id="third-party-services" class="mb-5">
		<h2 class="mb-3">Third-party services</h2>
		<p class="lead">
			No satire in this section. To show you this page your browser also fetches files from the services below. Each one
			receives your IP address, your browser's user agent and (usually) the name of this site, the same way any web
			server does, and may keep them in its own logs.
		</p>
		<ul class="d-flex flex-column gap-2">
			<li>
				<strong>jsDelivr</strong> (<code>cdn.jsdelivr.net</code>) — a public CDN that serves Bootstrap and Bootstrap Icons
				on every page, plus the PhotoSwipe image viewer on pages with an image gallery.
			</li>
			{% if site.defaultBootswatchTheme != "default" or site.bootswatchSwitcher %}
			<li>
				<strong>cdnjs</strong> (<code>cdnjs.cloudflare.com</code>, run by Cloudflare) — serves the Bootswatch theme
				stylesheet{% if site.defaultBootswatchTheme == "default" %} when you pick one in the theme switcher{% endif %}.
			</li>
			{% endif %}
			{% if site.googleFontsUrl or themeFonts or site.bootswatchSwitcher %}
			<li>
				<strong>Google Fonts</strong> (<code>fonts.googleapis.com</code>, <code>fonts.gstatic.com</code>) — serves the
				web fonts{% if not site.googleFontsUrl %} that the Bootswatch theme stylesheet imports{% if not themeFonts %}
				(only after you pick such a theme in the theme switcher){% endif %}{% endif %}.
			</li>
			{% endif %}
			{% if site.gaId %}
			<li>
				<strong>Google Analytics</strong> (<code>www.googletagmanager.com</code>) — visit statistics, using the cookies
				described in the <a href="#cookie-policy">Cookie Policy</a>.
			</li>
			{% endif %}
			<li>
				<strong>Our web host</strong> — like every web server, it logs each request (IP address, time, page, browser) to
				keep the site running and secure.
			</li>
		</ul>
	</section>

