---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
layout: false
---
{
	"name": "{{ site.webmanifest.name }}",
	"short_name": "{{ site.webmanifest.shortName }}",
	"icons": [
		{
			"src": "/assets/img/web-app-manifest-192x192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/assets/img/web-app-manifest-512x512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"theme_color": "{{ site.webmanifest.themeColor }}",
	"background_color": "{{ site.webmanifest.backgroundColor }}",
	"display": "standalone"
}
