---
permalink: /.htaccess
eleventyExcludeFromCollections: true
layout: false
---
# ============================================================
#  .htaccess for {{ site.name | safe }} — {{ site.url | safe }}
#  Generated by Eleventy from src/htaccess.njk
# ============================================================

# --- Error documents ---
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

# --- Security basics ---
Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8
FileETag None

# --- Protect any .ht* file from being read ---
#     Covers .htaccess, .htpasswd, .htpasswd-<domain>, and any future
#     .ht* convention files. Apache's default config usually does this
#     already; we keep an explicit rule as belt-and-braces.
<FilesMatch "^\.ht">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
</FilesMatch>

# --- Force HTTPS ---
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} off
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- www → non-www redirect (bare domain is canonical) ---
#     The target is this site's own address from site.json, NOT the Host
#     header the request came with. The usual recipe captures the host
#     from %{HTTP_HOST} ("RewriteRule ^ https://%1%{REQUEST_URI}") and so
#     sends the visitor wherever that header says: if a request with a
#     foreign Host ever reaches this file (default vhost, wildcard
#     alias), that is an open redirect. Only hosts starting with "www."
#     match, so a local domain (bp.test, or the real domain mapped in
#     the hosts file) is never redirected. On Domeneshop a proxy answers
#     www. before Apache sees it; other hosts rely on this rule. Not
#     generated when site.url itself is a www. host (it would loop).
{%- if (site.url | hostname).indexOf("www.") != 0 %}
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_HOST} ^www\. [NC]
	RewriteRule ^ {{ site.url | safe }}%{REQUEST_URI} [R=301,L]
</IfModule>
{%- else %}
#     (skipped: site.url is a www. host)
{%- endif %}

# --- Clean URLs: strip index.html from any request ---
#     THE_REQUEST is the raw request line the browser sent, e.g.
#     "GET /about/index.html HTTP/1.1". Apache's own internal lookup of
#     index.html for "/about/" never shows up there, so this can't loop.
#     ((?:[^\s?]*/)?) only captures whole folders, so the file name must be
#     exactly index.html: /docs/apiindex.html is left alone instead of
#     being sent to /docs/api. NE ("no escape") passes the captured path on
#     as sent: it is already percent-encoded, and without NE /my%20dir/
#     would become /my%2520dir/. A query string is kept automatically:
#     /about/index.html?x=1 → /about/?x=1.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
	RewriteRule ^ /%1 [R=301,L,NE]
</IfModule>

# --- Block TRACE and TRACK methods ---
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
	RewriteRule .* - [F]
</IfModule>

# --- Query string injection filter: OFF (static site) ---
#     Nothing on a static site reads the query string, so these rules
#     guarded nothing, but they DID answer harmless links with a 403:
#       ?utm_campaign=Request%20a%20quote   ("REQUEST" followed by %)
#       ?q=%22hi%22%3A                      (a quote, then any encoded : = ?)
#       ?url=http://localhost:3000          ("localhost" anywhere)
#       ?q=x;dropdown                       (select/update/drop as plain
#                                           text after a ; or a quote)
#     A share link that 403s also loses its preview card, because the
#     social crawler gets the 403 too. Meanwhile a real attack only has
#     to send the quote as %27 to slip past. Kept (commented) for a derived
#     PHP project that reads $_GET: uncomment the whole block, <IfModule>
#     lines included. Better still, keep only the script, boot.ini /
#     etc/passwd and base64_encode lines, which have no plausible harmless
#     match.
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteBase /
#	RewriteCond %{QUERY_STRING} (\"|%22).*(<|>|%3) [NC,OR]
#	RewriteCond %{QUERY_STRING} (javascript:).*(\;) [NC,OR]
#	RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3) [NC,OR]
#	RewriteCond %{QUERY_STRING} (\;|'|\"|%22).*(union|select|insert|drop|update|md5|benchmark) [NC,OR]
#	RewriteCond %{QUERY_STRING} (base64_encode|localhost) [NC,OR]
#	RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd) [NC,OR]
#	RewriteCond %{QUERY_STRING} (GLOBALS|REQUEST)(=|\[|%) [NC]
#	RewriteRule .* - [F]
#</IfModule>

# --- Block suspicious file extensions ---
<IfModule mod_alias.c>
	RedirectMatch 403 (eval\(|base64_encode|proc/self/environ)
	RedirectMatch 403 \.(exe|dll|mdb|sql|ini|rar|cfg)$
</IfModule>

# --- MIME types ---
#     For file types the server's mime.types may not know. site.webmanifest
#     went out with no Content-Type at all on the production host, and
#     every rule below that is keyed on a type skips a file without one.
#     .svgz is gzip-compressed SVG, so it also needs its Content-Encoding.
AddType image/svg+xml svg svgz
AddEncoding gzip svgz
AddType image/avif avif
AddType application/manifest+json webmanifest
AddType video/mp4 mp4
#     .ico: many hosts (Domeneshop included) say image/vnd.microsoft.icon;
#     pin it so the favicon cache/gzip rules below (keyed on image/x-icon)
#     apply. Same move as h5bp's server configs.
AddType image/x-icon ico cur

# --- Security headers ---
#     CSP intentionally skipped. For a static site with no user-generated
#     content, no forms and no logins, a strict CSP is more maintenance
#     burden than protection: every CDN and third-party endpoint has to be
#     allowlisted, and a miss silently breaks Bootstrap, PhotoSwipe or
#     analytics. The headers below do real work for effectively zero
#     ongoing cost.
#     "always" puts them on every response Apache sends, including the
#     redirects it makes itself (like the index.html strip above) and
#     error pages; plain "Header set" can miss those. A redirect made by
#     a proxy in front of Apache (on Domeneshop: the www → bare-domain
#     301) never reaches this file, so no .htaccess can add headers to it.
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

	# --- Strict-Transport-Security (HSTS): OFF until HTTPS is verified ---
	#     Tells a browser to use only https:// for this host from now on,
	#     so a returning visitor's typed http:// request is upgraded inside
	#     the browser and can't be intercepted (SSL-stripped) on hostile
	#     Wi-Fi. The catch: a browser that has cached it refuses plain http
	#     AND any certificate error for the whole max-age. If the
	#     certificate breaks later, visitors get stuck on a browser error
	#     page until it's fixed or max-age runs out. So stage it, after the
	#     site is live and https:// is verified (valid certificate, no
	#     mixed-content warnings):
	#       1. uncomment the max-age=300 line (5 minutes) for a day;
	#       2. then swap it for the max-age=31536000 line (1 year).
	#     Leave includeSubDomains off unless EVERY subdomain serves valid
	#     HTTPS. On a hub domain it would cover every subdomain too,
	#     and they have their own lifecycles.
	# Header always set Strict-Transport-Security "max-age=300"
	# Header always set Strict-Transport-Security "max-age=31536000"
{%- if site.noindexSite %}

	# --- Site-wide noindex: ON, because site.json has "noindexSite": true ---
	#     Every page and file tells search engines not to index it or
	#     follow its links. That includes PDFs and images, which a
	#     <meta name="robots"> tag can't reach. Don't ALSO add
	#     "Disallow: /" to robots.txt: a crawler that may not fetch a page
	#     never sees this header, and can still list the bare URL.
	#     `always`, like the headers above: Apache's own redirects and
	#     error responses must carry the noindex too.
	Header always set X-Robots-Tag "noindex, nofollow"
{%- elif site.llmsTxt !== false %}

	# --- llms.txt: readable, but not a search result ---
	#     The file is for AI tools; people should land on the real pages.
	#     Google's John Mueller has said keeping llms.txt out of the index
	#     "could make sense", so a link to it can't make Google show the
	#     raw text file instead of the HTML. noindex only affects search
	#     listings: robots.txt still lets crawlers and AI tools fetch it.
	<Files "llms.txt">
		Header set X-Robots-Tag "noindex"
	</Files>
{%- endif %}
</IfModule>

# --- Gzip compression ---
#     Both JS MIME types: Apache 2.4.62+ ships a mime.types that maps .js
#     to text/javascript (the IANA registration); older builds, including
#     Domeneshop's today, still say application/javascript. A rule keyed
#     on only one of them silently stops applying the day the server's
#     mime table changes. (Measured on fg, 2026-09-11: local Apache 2.4.62
#     served JS as text/javascript with NO cache header, while production,
#     on application/javascript, had the full year.)
#     text/plain and the XML types cover robots.txt, llms.txt, humans.txt,
#     security.txt and sitemap.xml.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
	AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/manifest+json
	AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
</IfModule>

# --- Cache static assets ---
#     CSS and JS: a year. Every page links them with ?v=<build stamp>, so
#     each deploy gives them a new URL and browsers fetch the new file.
#     Images are linked WITHOUT a version, so an image replaced under the
#     same file name stays stale in a returning visitor's cache for as
#     long as this says. Hence a month (a week for the favicon and the
#     manifest, as in h5bp's server configs). To swap an image sooner,
#     give it a new file name, or link it through the `v` filter
#     (eleventy.config.js: ?v=<content hash>), as head-meta.njk does for
#     og:image. Once every image is linked that way, these can go up to
#     a year too.
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 month"
	ExpiresByType image/png "access plus 1 month"
	ExpiresByType image/gif "access plus 1 month"
	ExpiresByType image/webp "access plus 1 month"
	ExpiresByType image/avif "access plus 1 month"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType image/x-icon "access plus 1 week"
	ExpiresByType application/manifest+json "access plus 1 week"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType font/woff "access plus 1 year"
	ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
