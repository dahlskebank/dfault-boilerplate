---
permalink: /.well-known/security.txt
eleventyExcludeFromCollections: true
layout: false
---
{#- Plain text: `| safe` stops Nunjucks' HTML auto-escaping (an "&" in a
	URL would otherwise print as "&amp;").
	Expires: site.json → security.expires if set, otherwise build date
	+ 1 year from src/_data/build.js (recomputed on every build). -#}
# ============================================================
#  security.txt for {{ site.name | safe }}
#  Per RFC 9116 — https://www.rfc-editor.org/rfc/rfc9116
#  Generated by Eleventy from src/security.txt.njk
# ============================================================
Contact: {{ site.security.contact | safe }}
Expires: {{ (site.security.expires or build.securityExpires) | safe }}
{%- if site.security.preferredLanguages %}
Preferred-Languages: {{ site.security.preferredLanguages | safe }}
{%- endif %}
Canonical: {{ site.url | safe }}/.well-known/security.txt
{%- if site.security.policy %}
Policy: {{ site.security.policy | safe }}
{%- endif %}
