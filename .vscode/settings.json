// VSCode workspace settings — applied only when this folder is open in VSCode.
//
// Purpose: gives every project derived from this boilerplate a subtle visual
// identity (colored title/activity/status bars + descriptive window title) so
// multiple open VSCode windows are distinguishable at a glance.
//
// In derived projects: change "peacock.color" below to a project-specific
// color, OR install the Peacock extension (johnpapa.vscode-peacock) and run
// "Peacock: Change to a Favorite Color" from the command palette — Peacock
// will rewrite the colorCustomizations block automatically to match.
{
	// VSCode's built-in CSS validator is OFF in this workspace because the
	// project runs stylelint (see stylelint.config.mjs) and the Stylelint
	// extension already reports syntax errors here — without this, a broken
	// stylesheet is flagged twice. Built-in CSS validation stays ON in the
	// global user settings: it is the safety net for projects that have no
	// stylelint. Derived projects inherit this file, and the gate with it.
	"css.validate": false,

	// Peacock single-source-of-truth color. The boilerplate's default is a
	// neutral slate gray so an unconfigured fork is obviously "the template".
	"peacock.color": "#3C4F65",

	// Direct VSCode color overrides. Tints only the title bar, activity bar
	// (left-edge icons), and status bar — never the editor or syntax colors.
	// Works even without the Peacock extension installed.
	"workbench.colorCustomizations": {
		"activityBar.activeBackground": "#4f6885",
		"activityBar.background": "#4f6885",
		"activityBar.foreground": "#e7e7e7",
		"activityBar.inactiveForeground": "#e7e7e799",
		"activityBarBadge.background": "#c49bae",
		"activityBarBadge.foreground": "#15202b",
		"statusBar.background": "#3c4f65",
		"statusBar.foreground": "#e7e7e7",
		"statusBarItem.hoverBackground": "#4f6885",
		"titleBar.activeBackground": "#3c4f65",
		"titleBar.activeForeground": "#e7e7e7",
		"titleBar.inactiveBackground": "#3c4f6599",
		"titleBar.inactiveForeground": "#e7e7e799",
		"commandCenter.border": "#e7e7e799",
		"sash.hoverBorder": "#4f6885",
		"statusBarItem.remoteBackground": "#28181f",
		"statusBarItem.remoteForeground": "#e7e7e7",
		"activityBarTop.activeBackground": "#4f6885",
		"activityBarTop.background": "#4f6885",
		"activityBarTop.foreground": "#e7e7e7",
		"activityBarTop.inactiveForeground": "#e7e7e799",
		"commandCenter.foreground": "#e7e7e7",
		"statusBar.debuggingBackground": "#3c4f65",
		"statusBar.debuggingForeground": "#e7e7e7",
		"activityBar.activeBorder": "#e7e7e7",
		"activityBarTop.activeBorder": "#e7e7e7",
		"statusBar.inactiveBackground": "#3c4f65"
	},

	// Hide worklog files from the Todo Tree extension. _md/worklog/ holds
	// historical checkpoint snapshots (VRFY/TEST/PEND items captured at
	// checkpoint time, plus swept DONE lines). The live action queue is
	// _md/TESTING.md — that stays scanned. Without this, Todo Tree
	// surfaces every old worklog entry as if it were live.
	"todo-tree.filtering.excludeGlobs": [
		"**/_md/worklog/**"
	]
	// `window.title` lives in the global user settings so every project's
	// VSCode window shows its folder name in the taskbar, not just this one.
}
