# ============================================================
#  .gitignore for Eleventy project
# ============================================================

# Eleventy build output (regenerated on every build)
_site/

# Node.js dependencies (reinstalled via npm install)
node_modules/

# Eleventy cache
.cache/

# OS files
Thumbs.db
.DS_Store

# Editor files
*.swp
*.swo

# VS Code — share the Peacock theme settings, ignore everything else
# (tasks.json/launch.json tend to accumulate machine-specific paths)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Environment variables / secrets
.env
.env.*
!.env.example

# Deploy lock (created by flock in deploy.sh)
.deploy.lock

# Temp/scratch files
_temp/

# Claude Code local settings
.claude/
